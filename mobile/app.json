{
  "expo": {
    "name": "RoundsAhead",
    "slug": "roundsahead",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "roundsahead",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roundsahead.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.roundsahead.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-asset",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
